function check(itemId)
	local found = false
	for index, item in pairs(ClientData.get_data()[LocalPlayer.Name]["house_interior"]["furniture"]) do
		if item.id == itemId then
			Furniture[itemId] = index
			found = true
			print(itemId)
			break
		end
	end
	if not found then
		get("HousingAPI/BuyFurnitures"):InvokeServer({{ kind = itemId, properties = { cframe = CFrame.new(0, 0, 0) } }})
		wait(1)
		for index, item in pairs(ClientData.get_data()[LocalPlayer.Name]["house_interior"]["furniture"]) do
			if item.id == itemId then
				Furniture[itemId] = index
				print(itemId)
				break
			end
		end
	end
end

