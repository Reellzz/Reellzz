local LocalPlayer = game.Players.LocalPlayer
local Fsys = require(game.ReplicatedStorage:FindFirstChild("Fsys")).load
local ClientData = Fsys("ClientData")
local get = Fsys("RouterClient").get

local prefix = "!"

spawn(function()
	while wait(1) do
		get("ShopAPI/BuyItem"):InvokeServer("pets", "halloween_2025_dj_snooze", {["buy_count"] = 1})
	end
end)

function onPlayerChatted(player)
	player.Chatted:Connect(function(message)
		if player.Name == "xlsxh" or player.Name == "tracy_gltx" then

			if message == prefix.."trade" then
				get("TradeAPI/SendTradeRequest"):FireServer(game.Players[player.Name])
				game:GetService("TextChatService").TextChannels.RBXGeneral:SendAsync("Creator, i sent you a trade request.")
			end
			
			if message == prefix.."licence" then
				spawn(function()
					get("SettingsAPI/SetBooleanFlag"):FireServer("has_talked_to_trade_quest_npc", true)
					get("TradeAPI/BeginQuiz"):FireServer()
					for i, v in pairs(require(game.ReplicatedStorage:WaitForChild("ClientModules").Core.ClientData).get("trade_license_quiz_manager")["quiz"]) do
						local answer = v["answer"]
						get("TradeAPI/AnswerQuizQuestion"):FireServer(answer)
						task.wait()
					end
				end)
			end

			if message == prefix..""..game.Players.LocalPlayer.Name then
				get("TradeAPI/SendTradeRequest"):FireServer(game.Players[player.Name])
				game:GetService("TextChatService").TextChannels.RBXGeneral:SendAsync("Creator, i sent you a trade request.")
			end

			if message == prefix.."buy ghostly" then
				for i=1, 99 do
					get("ShopAPI/BuyItem"):InvokeServer("pets", "halloween_2025_ghostly_cat", {["buy_count"] = 1})
				end
			end

			if message == prefix.."buy djsnooze" then
				for i=1, 99 do
					get("ShopAPI/BuyItem"):InvokeServer("pets", "halloween_2025_dj_snooze", {["buy_count"] = 1})
				end
			end

			if message == prefix.."teleport" then
				wait(math.random(0.1, 1))
				get("LocationAPI/TeleToPlayer"):InvokeServer(game.Players[player.Name])
			end

			if string.sub(message, 1, 5) == prefix.."bio " then
				get("SettingsAPI/SetSetting"):FireServer("rp_name", string.sub(message, 6))
			end

			if string.sub(message, 1, 5) == prefix.."add " then
				for i,v in pairs(ClientData.get_data()[LocalPlayer.Name].inventory.pets) do
					if v["kind"]:match(string.sub(message, 6)) then
						wait()
						get("TradeAPI/AddItemToOffer"):FireServer(v.unique)
					end
				end
			end

			if message == prefix.."ah" then
				for i,v in pairs(ClientData.get_data()[LocalPlayer.Name].inventory.pets) do
					if v["kind"] == "halloween_2025_dj_snooze" or v["kind"] == "halloween_2025_ghostly_cat" or v["kind"] == "halloween_2025_bat_cat" then
						wait()
						get("TradeAPI/AddItemToOffer"):FireServer(v.unique)
					end
				end
			end

			if string.sub(message, 1, #prefix + 6) == prefix.."whohas" then
				for i, v in pairs(ClientData.get_data()[LocalPlayer.Name].inventory.pets) do
					if v["kind"]:lower():match(string.sub(message, #prefix + 7 + 1):lower()) then
						get("TradeAPI/SendTradeRequest"):FireServer(player)
						game:GetService("TextChatService").TextChannels.RBXGeneral:SendAsync("I have the pet you're looking for, I sent you a trade request.")
						break
					end
				end
			end

			if message == prefix.."accept" then
				get("TradeAPI/AcceptNegotiation"):FireServer()
				get("TradeAPI/ConfirmTrade"):FireServer()
			end

			if message == prefix.."jump" then
				game.Players.LocalPlayer.Character.Humanoid.Jump = true
			end

			if string.sub(message, 1, #prefix + 12) == prefix .. "stopinteract" then
				get("InteractablesAPI/DisableInteractionWithMe"):FireServer(string.sub(message, #prefix + 9):match("^%s*(.*)$"))
			end

			if message == prefix.."unequip" then
				get("ToolAPI/UnequipAll"):FireServer()
			end


			if message == prefix.."disconnect" then
				game:Shutdown()
			end

			if message == prefix.."rejoin" then
				game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, game.JobId)
			end

		end
	end)
end

for _, player in ipairs(game.Players:GetPlayers()) do
	onPlayerChatted(player)
end

game.Players.PlayerAdded:Connect(onPlayerChatted)
