task.spawn(function()
	local R = game:GetService("ReplicatedStorage")
	local C = require(R.Fsys).load("ClientData")
	local K = require(R.SharedModules.ContentPacks.Halloween2026.Game.TheCrypt.CryptConstants)
	local U = R.adoptme_new_net:WaitForChild("Halloween2026/UnlockPadlock")

	while task.wait(5) do
		if not GMC.is_participating and not HMC.is_participating then
			for _, v in pairs(C.get("inventory").toys) do
				if v.kind == K.KEY_ITEM_KIND then
					R.API["ToolAPI/Equip"]:InvokeServer(v.unique)
					break
				end
			end

			get("LocationAPI/SetLocation"):FireServer("TheCrypt")

			local d = C.get(K.STORE_KEY)
			if d and d.floors then
				local a, b = {}, {}

				for f, floor in pairs(d.floors) do
					for i, id in pairs(floor.coffins) do
						local s = (tostring(id) .. tostring(floor.rewards and floor.rewards[id] and floor.rewards[id].kind)):lower()
						local v = {floor_index = f, padlock_index = i}
						if s:find("ginormous") then
							a[#a+1] = v
						elseif id == "ladder" or s:find("candy") then
							b[#b+1] = v
						end
					end
				end

				for _, list in ipairs({a, b}) do
					for _, v in ipairs(list) do
						pcall(function() U:InvokeServer(v) end)
						task.wait(.1)
					end
				end

				R.adoptme_new_net:WaitForChild("Halloween2026/ClaimTombSpider"):InvokeServer()
			end
		end
	end
end)

