local GhostClustersPropRenderer = require(ReplicatedStorage.SharedModules.ContentPacks.Halloween2026.Game.GhostClusters.GhostClustersPropRenderer)

local Remote = ReplicatedStorage:WaitForChild("API"):WaitForChild("MinigameAPI/MessageServer")

spawn(function()
	while wait() do
		get("InteractablesAPI/DisableInteractionWithMe"):FireServer(true)

		if not a.is_participating then continue end
		local visuals = workspace:FindFirstChild("GhostClustersVisuals")
		local hasFreeGhosts = false

		if visuals then
			for _, v in pairs(visuals:GetChildren()) do
				local ghost_id =
					v.Name:match("^Ghost_Large_(.+)")
					or v.Name:match("^Ghost_Small_(.+)")
					or v.Name:match("^Ghost_Medium_(.+)")

				if ghost_id then
					hasFreeGhosts = true
					local target = v:FindFirstChild("RootPart", true)
					if target and target:IsA("BasePart") then
						root.CFrame = target.CFrame
						Remote:FireServer(m.instanced_minigame.minigame_id,"start_contribute",{["ghost_id"] = ghost_id,["use_token"] = "SnusVille"})
					end
				end

			end
		end

		if not hasFreeGhosts then
			for _, target in GhostClustersPropRenderer.get_targets(true) do
				local unique = target.unique
				local model = target.model
				if unique and model then
					local teleportPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
					if teleportPart then
						root.CFrame = teleportPart.CFrame
						Remote:FireServer(m.instanced_minigame.minigame_id,"start_prop_contribute",{["unique"] = unique,["use_token"] = "SnusVille"})
					end
				end
			end
		end

	end
end)

