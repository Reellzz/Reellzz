spawn(function()
	while task.wait(0.5) do
		for _, minigame in pairs(games.get_all()) do
			local id = minigame.minigame_id:lower()

			if id:find("ghost") or id:find("hauntlet") then
				local info = data.get(minigame.cycle_timestamp_key)

				if info and info.timestamp and notified[id] ~= info.timestamp then
					local remaining = info.timestamp - time.now()

					if remaining > 0 and remaining < 60 then
						local name = id:find("ghost") and "ghost" or "hauntlet"
						local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

						if root then
							if name == "ghost" then
								LocalPlayer.Character.HumanoidRootPart.CFrame = workspace.StaticMap.TeleportLocations.ghost_clusters.CFrame
								SetLocation("HauntedManor", "MainDoor", {})
								wait(2)
								LocalPlayer.Character.HumanoidRootPart.CFrame = workspace.StaticMap.TeleportLocations.ghost_clusters.CFrame
							elseif name == "hauntlet" then
								LocalPlayer.Character.HumanoidRootPart.CFrame = workspace.StaticMap.TeleportLocations.hauntlet.CFrame
								SetLocation("HauntedHotel", "MainDoor", {})
								wait(2)
								LocalPlayer.Character.HumanoidRootPart.CFrame = workspace.StaticMap.TeleportLocations.hauntlet.CFrame
							end

							notified[id] = info.timestamp
							print("Téléporté à", name)
						end
					end
				end
			end
		end
	end
end)

spawn(function()
	while wait() do
		get("InteractablesAPI/DisableInteractionWithMe"):FireServer(true)

		if not GMC.is_participating then continue end
		local visuals = workspace:FindFirstChild("GhostClustersVisuals")
		local hasFreeGhosts = false

		if visuals then
			for _, v in pairs(visuals:GetChildren()) do
				local ghost_id =
					v.Name:match("^Ghost_Large_(.+)")
					or v.Name:match("^Ghost_Small_(.+)")
					or v.Name:match("^Ghost_Medium_(.+)")

				if ghost_id then
					hasFreeGhosts = true
					local target = v:FindFirstChild("RootPart", true)
					if target and target:IsA("BasePart") then
						LocalPlayer.Character.HumanoidRootPart.CFrame = target.CFrame
						get("MinigameAPI/MessageServer"):FireServer(GMC.instanced_minigame.minigame_id,"start_contribute",{["ghost_id"] = ghost_id,["use_token"] = "SnusVille"})
					end
				end

			end
		end

		if not hasFreeGhosts then
			for _, target in require(ReplicatedStorage.SharedModules.ContentPacks.Halloween2026.Game.GhostClusters.GhostClustersPropRenderer).get_targets(true) do
				local unique = target.unique
				local model = target.model
				if unique and model then
					local teleportPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
					if teleportPart then
						LocalPlayer.Character.HumanoidRootPart.CFrame = teleportPart.CFrame
						get("MinigameAPI/MessageServer"):FireServer(GMC.instanced_minigame.minigame_id,"start_prop_contribute",{["unique"] = unique,["use_token"] = "SnusVille"})
					end
				end
			end
		end

	end
end)

